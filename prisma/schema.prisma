generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMINISTRADOR
  FUNCIONARIO
}

enum StatusRecebimento {
  RECEBIDO
  PENDENTE
}

enum StatusDespesa {
  PAGO
  PENDENTE
}

enum StatusConta {
  PENDENTE
  PAGO
  ATRASADO
}

enum StatusCliente {
  ATIVO
  INATIVO
}

enum TipoLembreteEmail {
  ANTES_VENCIMENTO
  DIA_VENCIMENTO
  ATRASADO
}

model Empresa {
  id           String   @id @default(cuid())
  razaoSocial  String   @map("razao_social")
  nomeFantasia String   @map("nome_fantasia")
  cnpj         String   @unique
  telefone     String?
  email        String
  endereco     String?
  criadoEm     DateTime @default(now()) @map("criado_em")

  usuarios          Usuario[]
  entradas          Entrada[]
  saidas            Saida[]
  contasPagar       ContaPagar[]
  clientes          Cliente[]
  configNotificacao ConfigNotificacao?
  lembretesEmail    LembreteEmail[]

  @@map("empresas")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")
  empresaId String   @map("empresa_id")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("usuarios")
}

model Entrada {
  id              String            @id @default(cuid())
  data            DateTime
  descricao       String
  categoria       String
  cliente         String
  formaPagamento  String            @map("forma_pagamento")
  valor           Decimal           @db.Decimal(12, 2)
  status          StatusRecebimento @default(RECEBIDO)
  empresaId       String            @map("empresa_id")
  criadoEm        DateTime          @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("entradas")
}

model Saida {
  id              String        @id @default(cuid())
  data            DateTime
  descricao       String
  categoria       String
  fornecedor      String
  formaPagamento  String        @map("forma_pagamento")
  valor           Decimal       @db.Decimal(12, 2)
  status          StatusDespesa @default(PAGO)
  empresaId       String        @map("empresa_id")
  criadoEm        DateTime      @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("saidas")
}

model ContaPagar {
  id          String      @id @default(cuid())
  descricao   String
  fornecedor  String
  valor       Decimal     @db.Decimal(12, 2)
  vencimento  DateTime    @map("data_vencimento")
  status      StatusConta @default(PENDENTE)
  empresaId   String      @map("empresa_id")
  criadoEm    DateTime    @default(now()) @map("criado_em")

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lembretesEmail LembreteEmail[]

  @@index([empresaId])
  @@map("contas_a_pagar")
}

model Cliente {
  id        String        @id @default(cuid())
  nome      String
  telefone  String?
  email     String?
  documento String?
  endereco  String?
  status    StatusCliente @default(ATIVO)
  empresaId String        @map("empresa_id")
  criadoEm  DateTime      @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("clientes")
}

model ConfigNotificacao {
  id                     String   @id @default(cuid())
  empresaId              String   @unique @map("empresa_id")
  emailVencimentosAtivo  Boolean  @default(false) @map("email_vencimentos_ativo")
  emailDestino           String?  @map("email_destino")
  emailDiasAntes         Int      @default(3) @map("email_dias_antes")
  emailNoDiaVencimento   Boolean  @default(true) @map("email_no_dia_vencimento")
  emailAtrasados         Boolean  @default(true) @map("email_atrasados")
  criadoEm               DateTime @default(now()) @map("criado_em")
  atualizadoEm           DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("config_notificacoes")
}

model LembreteEmail {
  id           String            @id @default(cuid())
  contaPagarId String            @map("conta_pagar_id")
  empresaId    String            @map("empresa_id")
  tipo         TipoLembreteEmail
  email        String
  assunto      String
  sucesso      Boolean           @default(true)
  enviadoEm    DateTime          @default(now()) @map("enviado_em")

  contaPagar ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([contaPagarId, tipo])
  @@index([empresaId])
  @@map("lembretes_email")
}
