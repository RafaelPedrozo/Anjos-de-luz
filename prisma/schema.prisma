generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMINISTRADOR
  FUNCIONARIO
}

enum StatusAnimal {
  DISPONIVEL
  ADOTADO
  TRATAMENTO
}

enum TipoDoacao {
  PIX
  CARTAO
}

model Empresa {
  id           String   @id @default(cuid())
  razaoSocial  String   @map("razao_social")
  nomeFantasia String   @map("nome_fantasia")
  cnpj         String   @unique
  telefone     String?
  email        String
  endereco     String?
  criadoEm     DateTime @default(now()) @map("criado_em")

  usuarios          Usuario[]
  animais           Animal[]
  resgates          Resgate[]
  adocoes           Adocao[]
  doacoes           Doacao[]
  configNotificacao ConfigNotificacao?

  @@map("empresas")
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")
  empresaId String   @map("empresa_id")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("usuarios")
}

model Animal {
  id          String       @id @default(cuid())
  nome        String
  especie     String
  status      StatusAnimal @default(DISPONIVEL)
  foto        String?
  dataResgate DateTime     @map("data_resgate")
  empresaId   String       @map("empresa_id")
  criadoEm    DateTime     @default(now()) @map("criado_em")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  resgates Resgate[]
  adocoes  Adocao[]

  @@index([empresaId])
  @@map("animais")
}

model Resgate {
  id        String   @id @default(cuid())
  local     String
  custos    Decimal  @db.Decimal(12, 2)
  descricao String
  data      DateTime @default(now())
  animalId  String   @map("animal_id")
  empresaId String   @map("empresa_id")
  criadoEm  DateTime @default(now()) @map("criado_em")

  animal  Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([animalId])
  @@map("resgates")
}

model Adocao {
  id               String   @id @default(cuid())
  animalId         String   @map("animal_id")
  adotanteNome     String   @map("adotante_nome")
  adotanteEmail    String?  @map("adotante_email")
  adotanteTelefone String?  @map("adotante_telefone")
  data             DateTime
  empresaId        String   @map("empresa_id")
  criadoEm         DateTime @default(now()) @map("criado_em")

  animal  Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([animalId])
  @@map("adocoes")
}

model Doacao {
  id        String     @id @default(cuid())
  valor     Decimal    @db.Decimal(12, 2)
  tipo      TipoDoacao
  doador    String
  data      DateTime
  empresaId String     @map("empresa_id")
  criadoEm  DateTime   @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("doacoes")
}

model ConfigNotificacao {
  id                    String   @id @default(cuid())
  empresaId             String   @unique @map("empresa_id")
  emailVencimentosAtivo Boolean  @default(false) @map("email_vencimentos_ativo")
  emailDestino          String?  @map("email_destino")
  emailDiasAntes        Int      @default(3) @map("email_dias_antes")
  emailNoDiaVencimento  Boolean  @default(true) @map("email_no_dia_vencimento")
  emailAtrasados        Boolean  @default(true) @map("email_atrasados")
  criadoEm              DateTime @default(now()) @map("criado_em")
  atualizadoEm          DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("config_notificacoes")
}
